# === Application ===
APP_NAME=VortexM
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key-min-32-chars
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === Database ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=vortexm
POSTGRES_PASSWORD=vortexm_secret
POSTGRES_DB=vortexm
DATABASE_URL=postgresql+asyncpg://vortexm:vortexm_secret@postgres:5432/vortexm

# === Redis ===
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# === JWT ===
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# === Encryption (AES-256-GCM for messages at rest) ===
MESSAGE_ENCRYPTION_KEY=base64:32-byte-key-here-replace-in-production==

# === SMTP (Mail.ru / Yandex) ===
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=your-email@mail.ru
SMTP_PASSWORD=your-app-password
SMTP_FROM=VortexM <noreply@mail.ru>
SMTP_USE_TLS=true

# === MinIO / S3 (VK Cloud Object Storage compatible) ===
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=vortexm
S3_REGION=ru-msk
S3_PUBLIC_URL=http://localhost:9000/vortexm

# === LiveKit (self-hosted) ===
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# === YooKassa ===
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
YOOKASSA_WEBHOOK_SECRET=your-webhook-secret
YOOKASSA_RETURN_URL=http://localhost:3000/wallet/success
YOOKASSA_MOCK=true
# Webhook URL for production: https://your-domain/api/v1/wallet/webhook

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# === Superadmin seed ===
SUPERADMIN_USERNAME=моргенштерн@2399
SUPERADMIN_PASSWORD=10МнЛмЗ14%
SUPERADMIN_EMAIL=superadmin@vortexm.local

# === Rate limits ===
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
REGISTRATION_LOCKOUT_HOURS=24
