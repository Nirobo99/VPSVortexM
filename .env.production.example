# =============================================================================
# VortexM — PRODUCTION environment template
# Copy to .env on the server:  cp .env.production.example .env
# Replace ALL placeholder values before going live.
# =============================================================================

# === Domain (used in URLs below) ===
# Example: vortexm.example.ru
DOMAIN=your-domain.ru

# === Application ===
APP_NAME=VortexM
APP_ENV=production
DEBUG=false
SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_64
API_PREFIX=/api/v1
ALLOWED_ORIGINS=https://your-domain.ru

# === Database (Docker internal host: postgres) ===
POSTGRES_USER=vortexm
POSTGRES_PASSWORD=REPLACE_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=vortexm
DATABASE_URL=postgresql+asyncpg://vortexm:REPLACE_STRONG_POSTGRES_PASSWORD@postgres:5432/vortexm

# === Redis ===
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# === JWT ===
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
JWT_ISSUER=vortexm
JWT_AUDIENCE=vortexm-clients

# === Encryption (generate: openssl rand -base64 32) ===
MESSAGE_ENCRYPTION_KEY=base64:REPLACE_BASE64_32_BYTES==

# === CSRF / cookies (HTTPS required in production) ===
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_SAMESITE=strict

# === Rate limits ===
GLOBAL_RATE_LIMIT_PER_MINUTE=200
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
REGISTRATION_LOCKOUT_HOURS=24
WEBSOCKET_CONNECTIONS_PER_USER=5

# === reCAPTCHA v3 (optional but recommended) ===
RECAPTCHA_ENABLED=true
RECAPTCHA_SECRET_KEY=your-recaptcha-secret
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# === SMTP (Mail.ru / Yandex) ===
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=noreply@your-domain.ru
SMTP_PASSWORD=your-app-password
SMTP_FROM=VortexM <noreply@your-domain.ru>
SMTP_USE_TLS=true

# === S3 / MinIO (internal Docker MinIO OR external VK Cloud S3) ===
# For built-in MinIO (docker-compose.prod.yml):
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=REPLACE_MINIO_ACCESS_KEY
S3_SECRET_KEY=REPLACE_MINIO_SECRET_KEY
S3_BUCKET=vortexm
S3_REGION=ru-msk
S3_PUBLIC_URL=https://your-domain.ru/storage
S3_PRIVATE_BUCKET=true
STORAGE_PRESIGN_TTL_SECONDS=900

# === Nginx (HTTP until SSL is issued) ===
NGINX_CONFIG=./nginx/nginx.http-only.conf

# === LiveKit keys (must match infra/livekit.prod.yaml) ===
LIVEKIT_URL=wss://your-domain.ru/livekit
LIVEKIT_API_KEY=REPLACE_LIVEKIT_KEY
LIVEKIT_API_SECRET=REPLACE_LIVEKIT_SECRET

# === YooKassa ===
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
YOOKASSA_WEBHOOK_SECRET=your-webhook-secret
YOOKASSA_RETURN_URL=https://your-domain.ru/wallet/success
YOOKASSA_MOCK=false

# === Frontend (public URLs — must match DOMAIN) ===
NEXT_PUBLIC_API_URL=https://your-domain.ru/api/v1
NEXT_PUBLIC_WS_URL=wss://your-domain.ru/ws
NEXT_PUBLIC_LIVEKIT_URL=wss://your-domain.ru/livekit

# === Nginx / proxy ===
TRUSTED_PROXY_IPS=172.16.0.0/12,127.0.0.1,::1

# === Admin hardening (optional) ===
# ALLOWED_ADMIN_IPS=1.2.3.4,5.6.7.8
# ADMIN_SECRET_HEADER_VALUE=random-secret-header-value

# === Superadmin seed (CHANGE PASSWORD AFTER FIRST LOGIN) ===
SUPERADMIN_USERNAME=моргенштерн@2399
SUPERADMIN_PASSWORD=REPLACE_SUPERADMIN_PASSWORD
SUPERADMIN_EMAIL=admin@your-domain.ru
